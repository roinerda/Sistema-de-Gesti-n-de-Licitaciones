root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,cshtml}]
indent_size = 4

[*.cs]
# Organización de using
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:suggestion

# Estilo moderno de C#
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:suggestion
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_prefer_primary_constructors = false:suggestion

# Modificadores y campos
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
csharp_prefer_static_local_function = true:suggestion

# Nombres
dotnet_naming_rule.tipos_pascal_case.severity = warning
dotnet_naming_rule.tipos_pascal_case.symbols = tipos
dotnet_naming_rule.tipos_pascal_case.style = pascal_case
dotnet_naming_symbols.tipos.applicable_kinds = class,struct,interface,enum,delegate,method,property,event
dotnet_naming_symbols.tipos.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.campos_privados_guion_bajo.severity = warning
dotnet_naming_rule.campos_privados_guion_bajo.symbols = campos_privados
dotnet_naming_rule.campos_privados_guion_bajo.style = guion_bajo_camel_case
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.guion_bajo_camel_case.capitalization = camel_case
dotnet_naming_style.guion_bajo_camel_case.required_prefix = _

# Advertencias del compilador que no deben ignorarse en esta solución
dotnet_diagnostic.CS8618.severity = warning

# CA1000: el patrón Resultado<T>/PaginaResultado<T> expone fábricas estáticas por diseño;
# es la forma idiomática de construir resultados tipados sin sobrecargar los constructores.
dotnet_diagnostic.CA1000.severity = none
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = none

[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none

# Las migraciones las genera la herramienta de Entity Framework Core y no se editan a mano,
# por lo que no se les aplican las reglas de estilo y análisis de la solución.
[src/Licitaciones.Infrastructure/Persistencia/Migraciones/**.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
