# Plantilla de variables de entorno para Docker Compose.
#
#   cp .env.example .env
#
# El archivo .env contiene credenciales reales y está excluido del repositorio.
# Nunca se versiona ninguna contraseña: el enunciado lo prohíbe expresamente.

POSTGRES_DB=licitaciones
POSTGRES_USER=licitaciones

# Cámbiela por una contraseña propia antes de levantar el entorno.
POSTGRES_PASSWORD=cambie-esta-clave

# Puerto del equipo anfitrión donde quedará publicada la aplicación.
PUERTO_APLICACION=8080
