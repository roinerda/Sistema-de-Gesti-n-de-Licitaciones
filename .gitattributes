# Finales de línea LF en todo el repositorio, también en la copia de trabajo.
# Mantener un único marcador evita que «dotnet format --verify-no-changes» dé
# resultados distintos en Windows y en la integración continua sobre Linux.
* text=auto eol=lf

*.cs text diff=csharp
*.csproj text
*.sln text
*.props text
*.targets text
*.json text
*.md text
*.yml text
*.yaml text
*.cshtml text
*.css text
*.js text
*.sh text eol=lf

# Los archivos que consume Docker o Kubernetes se mantienen con LF: un retorno de
# carro dentro de un patrón de .dockerignore o de un manifiesto puede alterarlo.
Dockerfile text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
docker-compose.yml text eol=lf
k8s/*.yaml text eol=lf
*.png binary
*.jpg binary
*.ico binary
