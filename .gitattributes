# Normaliza los finales de línea: el repositorio guarda LF y cada sistema
# operativo obtiene el final de línea que le corresponde al trabajar.
* text=auto

*.cs text diff=csharp
*.csproj text
*.sln text eol=crlf
*.props text
*.targets text
*.json text
*.md text
*.yml text
*.yaml text
*.cshtml text
*.css text
*.js text
*.sh text eol=lf

# Los archivos que consume Docker o Kubernetes se mantienen con LF: un retorno de
# carro dentro de un patrón de .dockerignore o de un manifiesto puede alterarlo.
Dockerfile text eol=lf
.dockerignore text eol=lf
.env.example text eol=lf
docker-compose.yml text eol=lf
k8s/*.yaml text eol=lf
*.png binary
*.jpg binary
*.ico binary
