<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Host web: interfaz MVC y, compuesta dentro del mismo proceso, la capa REST del proyecto Api.
    Es el único ejecutable de la solución, por lo que se despliega como un solo contenedor.
  -->
  <PropertyGroup>
    <RootNamespace>Licitaciones.Web</RootNamespace>
    <AssemblyName>Licitaciones.Web</AssemblyName>
    <UserSecretsId>licitaciones-web-utn-iti822</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Licitaciones.Api\Licitaciones.Api.csproj" />
    <ProjectReference Include="..\Licitaciones.Application\Licitaciones.Application.csproj" />
    <ProjectReference Include="..\Licitaciones.Infrastructure\Licitaciones.Infrastructure.csproj" />
  </ItemGroup>

</Project>
