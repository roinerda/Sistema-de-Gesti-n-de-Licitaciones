@model GuardarNivelAprobacionDto
@{
    ViewData["Title"] = "Editar nivel de aprobación";
    var id = (Guid)ViewData["Id"]!;
}

<h1 class="h3 mb-3">Editar nivel de aprobación</h1>

<div class="row">
    <div class="col-lg-6">
        <form method="post" asp-action="Editar" asp-route-id="@id">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input type="hidden" asp-for="Version" />

            <div class="mb-3">
                <label class="form-label" asp-for="MontoMinimoCrc"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input class="form-control" type="number" step="0.01" min="0.01" asp-for="MontoMinimoCrc" autofocus />
                </div>
                <span class="field-validation-valid" asp-validation-for="MontoMinimoCrc"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="MontoMaximoCrc"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input class="form-control" type="number" step="0.01" min="0.01" asp-for="MontoMaximoCrc" />
                </div>
                <span class="field-validation-valid" asp-validation-for="MontoMaximoCrc"></span>
                <div class="form-text">Déjelo vacío para el rango sin límite superior.</div>
            </div>

            <div class="mb-3">
                <label class="form-label" asp-for="Aprobador"></label>
                <input class="form-control" asp-for="Aprobador" />
                <span class="field-validation-valid" asp-validation-for="Aprobador"></span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ScriptsValidacion" />
}
