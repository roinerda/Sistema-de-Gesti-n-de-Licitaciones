@model GuardarProveedorDto
@{
    ViewData["Title"] = "Editar proveedor";
    var id = (Guid)ViewData["Id"]!;
}

<h1 class="h3 mb-3">Editar proveedor</h1>

<div class="row">
    <div class="col-lg-6">
        <form method="post" asp-action="Editar" asp-route-id="@id">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            @* La versión viaja oculta: si otra persona modificó el registro mientras este
               formulario estaba abierto, el guardado se rechaza en lugar de sobrescribir. *@
            <input type="hidden" asp-for="Version" />

            <div class="mb-3">
                <label class="form-label" asp-for="Nombre"></label>
                <input class="form-control" asp-for="Nombre" autocomplete="organization" autofocus />
                <span class="field-validation-valid" asp-validation-for="Nombre"></span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ScriptsValidacion" />
}
