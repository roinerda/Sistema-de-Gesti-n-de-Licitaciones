@model GuardarProveedorDto
@{
    ViewData["Title"] = "Nuevo proveedor";
}

<h1 class="h3 mb-3">Nuevo proveedor</h1>

<div class="row">
    <div class="col-lg-6">
        <form method="post" asp-action="Crear">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="Nombre"></label>
                <input class="form-control" asp-for="Nombre" autocomplete="organization" autofocus />
                <span class="field-validation-valid" asp-validation-for="Nombre"></span>
                <div class="form-text">
                    Solo se admiten letras, números, espacios, punto, coma y paréntesis. El nombre debe ser
                    único: los espacios repetidos y las mayúsculas no crean un proveedor distinto.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Guardar</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ScriptsValidacion" />
}
