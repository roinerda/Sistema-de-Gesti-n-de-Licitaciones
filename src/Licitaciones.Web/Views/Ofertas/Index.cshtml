@model PaginaResultado<OfertaDto>
@{
    ViewData["Title"] = "Ofertas";
    var parametros = ViewData["Parametros"] as ParametrosConsultaOfertas ?? new ParametrosConsultaOfertas();
    var licitaciones = ViewData["Licitaciones"] as IReadOnlyList<LicitacionDto> ?? [];
    var proveedores = ViewData["Proveedores"] as IReadOnlyList<ProveedorDto> ?? [];
    var paginacion = new PaginacionVista(Model.Pagina, Model.TotalPaginas, Model.TotalElementos, "Index");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Ofertas</h1>
    <a class="btn btn-primary" asp-action="Crear">Registrar oferta</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-sm-4">
        <label class="form-label" for="LicitacionId">Licitación</label>
        <select class="form-select" id="LicitacionId" name="LicitacionId">
            <option value="">Todas</option>
            @foreach (LicitacionDto licitacion in licitaciones)
            {
                <option value="@licitacion.Id" selected="@(parametros.LicitacionId == licitacion.Id)">
                    @licitacion.Codigo — @licitacion.Titulo
                </option>
            }
        </select>
    </div>
    <div class="col-sm-4">
        <label class="form-label" for="ProveedorId">Proveedor</label>
        <select class="form-select" id="ProveedorId" name="ProveedorId">
            <option value="">Todos</option>
            @foreach (ProveedorDto proveedor in proveedores)
            {
                <option value="@proveedor.Id" selected="@(parametros.ProveedorId == proveedor.Id)">@proveedor.Nombre</option>
            }
        </select>
    </div>
    <div class="col-sm-3">
        <label class="form-label" for="OrdenarPor">Ordenar por</label>
        <select class="form-select" id="OrdenarPor" name="OrdenarPor">
            <option value="monto" selected="@(parametros.OrdenarPor is null or "monto")">Monto</option>
            <option value="fecha" selected="@(parametros.OrdenarPor == "fecha")">Fecha de registro</option>
            <option value="proveedor" selected="@(parametros.OrdenarPor == "proveedor")">Proveedor</option>
            <option value="licitacion" selected="@(parametros.OrdenarPor == "licitacion")">Licitación</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Aplicar</button>
    </div>
</form>

@if (Model.Elementos.Count == 0)
{
    <div class="alert alert-info">No hay ofertas que coincidan con el filtro.</div>
}
else
{
    <div class="tabla-desplazable">
        <table class="table table-hover align-middle">
            <caption class="visually-hidden">Listado de ofertas registradas</caption>
            <thead>
                <tr>
                    <th scope="col">Licitación</th>
                    <th scope="col">Proveedor</th>
                    <th scope="col" class="columna-monto">Monto ofertado</th>
                    <th scope="col">Registrada</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (OfertaDto oferta in Model.Elementos)
                {
                    <tr>
                        <td>
                            <a asp-controller="Licitaciones" asp-action="Detalle" asp-route-id="@oferta.LicitacionId">
                                @oferta.LicitacionCodigo
                            </a>
                        </td>
                        <td>@oferta.ProveedorNombre</td>
                        <td class="columna-monto">@Html.Monto(oferta.MontoOfertadoCrc)</td>
                        <td>@Html.FechaLocal(oferta.FechaRegistro)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@oferta.Id">Editar</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Eliminar" asp-route-id="@oferta.Id">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacion" model="paginacion" />
}
