@model ActualizarOfertaDto
@{
    ViewData["Title"] = "Editar oferta";
    var oferta = (OfertaDto)ViewData["Oferta"]!;
}

<h1 class="h3 mb-3">Editar oferta</h1>

<div class="row">
    <div class="col-lg-6">
        <dl class="row">
            <dt class="col-sm-4">Licitación</dt>
            <dd class="col-sm-8">@oferta.LicitacionCodigo</dd>
            <dt class="col-sm-4">Proveedor</dt>
            <dd class="col-sm-8">@oferta.ProveedorNombre</dd>
        </dl>

        <form method="post" asp-action="Editar" asp-route-id="@oferta.Id">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input type="hidden" asp-for="Version" />

            <div class="mb-3">
                <label class="form-label" asp-for="MontoOfertadoCrc"></label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input class="form-control" type="number" step="0.01" min="0.01" asp-for="MontoOfertadoCrc" autofocus />
                </div>
                <span class="field-validation-valid" asp-validation-for="MontoOfertadoCrc"></span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Guardar cambios</button>
                <a class="btn btn-outline-secondary" asp-controller="Licitaciones" asp-action="Detalle" asp-route-id="@oferta.LicitacionId">
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ScriptsValidacion" />
}
