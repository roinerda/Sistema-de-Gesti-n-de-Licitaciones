@model PaginaResultado<TipoCambioDto>
@{
    ViewData["Title"] = "Tipos de cambio";
    var paginacion = new PaginacionVista(Model.Pagina, Model.TotalPaginas, Model.TotalElementos, "Index");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Tipos de cambio</h1>
    <a class="btn btn-primary" asp-action="Crear">Nuevo tipo de cambio</a>
</div>

<p class="text-body-secondary">
    El tipo de cambio se administra localmente, por lo que el sistema funciona sin acceso a Internet. Solo un
    registro puede estar activo: es el que se usa para mostrar los montos en dólares.
</p>

@if (Model.Elementos.Count == 0)
{
    <div class="alert alert-warning">No hay tipos de cambio registrados.</div>
}
else
{
    <div class="tabla-desplazable">
        <table class="table table-hover align-middle">
            <caption class="visually-hidden">Tipos de cambio registrados</caption>
            <thead>
                <tr>
                    <th scope="col" class="columna-monto">Colones por dólar</th>
                    <th scope="col">Vigente desde</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (TipoCambioDto tipoCambio in Model.Elementos)
                {
                    <tr class="@(tipoCambio.Activo ? "table-success" : null)">
                        <td class="columna-monto">@tipoCambio.CrcPorUsd.ToString("N4", ZonaHorariaCostaRica.Cultura)</td>
                        <td>@ZonaHorariaCostaRica.AHoraLocal(tipoCambio.FechaVigencia).ToString("dd/MM/yyyy", ZonaHorariaCostaRica.Cultura)</td>
                        <td>
                            @if (tipoCambio.Activo)
                            {
                                <span class="badge estado-publicada">Activo</span>
                            }
                            else
                            {
                                <span class="badge estado-borrador">Inactivo</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (!tipoCambio.Activo)
                            {
                                <form method="post" asp-action="Activar" asp-route-id="@tipoCambio.Id" class="d-inline">
                                    <button class="btn btn-sm btn-outline-primary" type="submit">Activar</button>
                                </form>
                            }
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@tipoCambio.Id">Editar</a>
                            @if (!tipoCambio.Activo)
                            {
                                <a class="btn btn-sm btn-outline-danger" asp-action="Eliminar" asp-route-id="@tipoCambio.Id">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Paginacion" model="paginacion" />
}
